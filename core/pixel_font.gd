const ACCENTS := {"Á": "A", "À": "A", "Â": "A", "Ã": "A", "É": "E", "Ê": "E", "Í": "I", "Ó": "O", "Ô": "O", "Õ": "O", "Ú": "U", "Ç": "C", "Ü": "U", "È": "E", "Ì": "I", "Ò": "O", "Ù": "U"}


static func width(text: String, cell: float) -> float:
	return text.length() * 6 * cell - cell


## Desenha `text` centrado em center_x, com `cell` píxeis por ponto.
static func draw(ci: CanvasItem, text: String, center_x: float, top: float, cell: float, color: Color) -> void:
	var x := center_x - width(text, cell) / 2
	for ch in text.to_upper():
		var g: Array = GLYPHS.get(ACCENTS.get(ch, ch), GLYPHS[" "])
		for r in 7:
			var row: String = g[r]
			var c := 0
			while c < 5:
				if row[c] == "#":
					var s := c
					while c < 5 and row[c] == "#":
						c += 1
					ci.draw_rect(Rect2(x + s * cell, top + r * cell, (c - s) * cell, cell), color)
				else:
					c += 1
		x += 6 * cell
